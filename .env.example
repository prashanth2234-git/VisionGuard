# ===================================================
# VisionGuard AI - Environment Configuration Example
# Copy this file to .env and provide your actual values
# ===================================================

NODE_ENV=development
PORT=4000

# Supabase PostgreSQL Database Connection
# If left blank during local development, an embedded SQLite database is used automatically
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authentication Secret
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key
JWT_EXPIRES_IN=7d

# Google Gemini Computer Vision API
# Required for live vision model inference
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Frontend URL (for CORS validation)
FRONTEND_URL=http://localhost:5173

# Upload Configuration
MAX_FILE_SIZE_MB=25
