# ===================================================
# VisionGuard AI Backend - Environment Configuration
# ===================================================

NODE_ENV=development
PORT=4000

# Supabase PostgreSQL Database Connection
# If left blank, an embedded SQLite database is used automatically
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authentication Secret
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key
JWT_EXPIRES_IN=7d

# Google Gemini Computer Vision API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Frontend URL (for CORS validation)
FRONTEND_URL=http://localhost:5173

# Upload Configuration
MAX_FILE_SIZE_MB=25
